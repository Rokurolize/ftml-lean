/-
  LeanFtml.ModuleCloserCompletenessProof — the closer-spelling converse for the Module family, delivered as a proof-grade bounded certificate AND as a universal theorem. This file is self-contained over LeanFtml.ModuleRules: it defines its own closer literal, generator, and near-miss quotient, and does not import the inherited ModuleProof (which another agent may be repairing).
  GENERATOR: certSpellings is the explicit case product of the six letters m o d u l e (each lower or upper) with the fixed ASCII bytes '[' '[' '/' ']' ']'; it is the same 64-list generator as the inherited closerSpellings. certNearMisses is a quotient of altered bracket bytes, injective altered letter bytes, 0xFF-adjacent lists, and wrong-length lists (truncations, extensions, doublings) generated by a flatMap over every spelling. Letter alterations use an injective bump so case information is preserved and the 704-element domain is duplicate-free. certDomain is certSpellings ++ certNearMisses.
  CARDINALITY: certSpellings.length = 64, certNearMisses.length = 640, certDomain.length = 704, and certDomain.Nodup — each proved by kernel decide below.
  ZERO-MISMATCH CHECK: cert_bounded_zero_mismatch is a kernel decide over all 704 generated candidates: for every c in certDomain, matchLitCI certCloser c = some [] iff c ∈ certSpellings, with zero mismatches. The certificate is bounded by construction and never labeled universal on its own.
  DETERMINISTIC HASH: fold over certDomain in generation order with step h,c ↦ foldl (acc,b ↦ (acc*257+b) mod 1000000007) ((h*257+c.length) mod 1000000007), seed 0. #eval certHash prints 555987450. The hash is a reproducibility marker for the generated list, not a proof ingredient.
  UNIVERSAL CLOSURE: cert_mem_ciMatches proves, by induction over an arbitrary pattern, that matchLitCI pat c = some [] iff c ∈ ciMatches pat, where ciMatches is the exact inverse generator (each pattern byte admits itself and its ASCII case swap; a non-letter has an identity swap, so no third byte can match). Instantiating at the 11-byte closer literal gives cert_universal: for EVERY byte list c, matchLitCI certCloser c = some [] iff c ∈ certSpellings. The reason is structural: byteCiEq x p is x == p || x == swapByteCase p, so each accepted byte is one of two exact values; brackets and slash are non-letters and fixed, and some [] forces length exactly 11.
  NAMED UNIVERSAL REMAINDER (exact): the inherited REPORT-PROOF-MODULE.md remainder "There is no theorem that `matchLitCI moduleCloser c = some []` implies `c ∈ closerSpellings`. Every generated spelling matches, and the generator is the case product of the six letters, but the converse is not a theorem." is CLOSED here on the byte-list domain: certCloser is the same 11-byte literal, certSpellings the same 64 case products, and matchLitCI the mirror's own function. What remains, and is NOT claimed, is: (a) any Boundary-B correspondence to PHP 8.5 / PCRE2 /i semantics — this is a theorem about the Lean mirror's byte matcher only; (b) any claim about placeholder bytes \\xFF\\lt k\\gt\\xFF, token tables, or closer parsing inside an arbitrary source — non-11-byte lists, including 0xFF-bearing ones, are rejected outright by cert_accepted_len11 rather than being silently "covered" by the quotient; (c) the report's other named remainder, that every moduleHead candidate rest is a suffix whose preceding eleven bytes are the closer findSubCI found for an arbitrary source. This file deliberately does NOT restate the bounded-only remainder wording, because the universal lemma makes that wording false; overstating a remainder would be as dishonest as mislabeling a bound universal.
-/

import LeanFtml.ModuleRules

set_option maxHeartbeats 20000000
set_option maxRecDepth 100000

namespace LeanFtml

/-- The mirror's closer literal, kept local so this file does not import the inherited ModuleProof. -/
def certCloser : List Nat := litBytes "[[/module]]"

/-- The eleven concrete bytes of the closer literal, written out so the inverse-generator lemma can be instantiated without unfolding String.toList. -/
def certCloserBytes : List Nat := [91, 91, 47, 109, 111, 100, 117, 108, 101, 93, 93]

theorem certCloser_eq_bytes : certCloser = certCloserBytes := by
  decide

/-- Exact byte predicate underlying matchLitCI: a byte matches a pattern byte when it is that byte or its ASCII case swap. -/
theorem cert_byteCiEq (x p : Nat) : byteCiEq x p = true ↔ x = p ∨ x = swapByteCase p := by
  simp [byteCiEq, beq_iff_eq]

/-- A Bool if-then-else returning an Option equals some [] exactly when the test is true and the branch is some []. -/
theorem cert_if_some_nil (hp : Bool) (ys : Option (List Nat)) :
    (if hp then ys else none) = some [] ↔ hp = true ∧ ys = some [] := by
  cases hp <;> simp

/-- The inverse generator of case-insensitive literal matching: for each pattern byte, admit the byte itself plus its case swap when distinct. A non-letter swaps to itself, so its alternative branch is empty. -/
def ciMatches : List Nat → List (List Nat)
  | [] => [[]]
  | p :: ps =>
      let rest := ciMatches ps
      rest.map (fun t => p :: t) ++
        (if swapByteCase p = p then [] else rest.map (fun t => swapByteCase p :: t))

/-- The defining equation at a cons pattern, stated separately so a rewrite touches only the head occurrence and not the recursive call on the right-hand side. -/
theorem ciMatches_cons_eq (p : Nat) (ps : List Nat) :
    ciMatches (p :: ps) =
      (ciMatches ps).map (fun t => p :: t) ++
        (if swapByteCase p = p then [] else (ciMatches ps).map (fun t => swapByteCase p :: t)) := rfl

/-- Membership in the inverse generator at a cons pattern: the head is the pattern byte or its case swap, and the tail is accepted by the rest. -/
theorem cert_mem_ciMatches_cons (p : Nat) (ps : List Nat) (x : Nat) (xs : List Nat) :
    x :: xs ∈ ciMatches (p :: ps) ↔
      (x = p ∨ x = swapByteCase p) ∧ xs ∈ ciMatches ps := by
  rw [ciMatches_cons_eq]
  by_cases hsw : swapByteCase p = p
  · rw [if_pos hsw]
    simp only [List.append_nil, List.mem_map]
    constructor
    · rintro ⟨t, ht, heq⟩
      injection heq with hxp hxt
      exact ⟨Or.inl hxp.symm, by simpa [hxt] using ht⟩
    · rintro ⟨hxOr, hxs⟩
      refine ⟨xs, hxs, ?_⟩
      rcases hxOr with hx | hx
      · subst x
        rfl
      · rw [hsw] at hx
        subst x
        rfl
  · rw [if_neg hsw]
    simp only [List.mem_append, List.mem_map]
    constructor
    · rintro (⟨t, ht, heq⟩ | ⟨t, ht, heq⟩)
      · injection heq with hxp hxt
        exact ⟨Or.inl hxp.symm, by simpa [hxt] using ht⟩
      · injection heq with hxp hxt
        exact ⟨Or.inr hxp.symm, by simpa [hxt] using ht⟩
    · rintro ⟨hxOr, hxs⟩
      rcases hxOr with hx | hx
      · left
        refine ⟨xs, hxs, ?_⟩
        subst x
        rfl
      · right
        refine ⟨xs, hxs, ?_⟩
        subst x
        rfl

/-- Universal inverse lemma: for every pattern and subject, matchLitCI pat c = some [] iff c is produced by ciMatches pat. Induction on the pattern, with the subject split only at a cons-cons step. -/
theorem cert_mem_ciMatches (pat c : List Nat) :
    matchLitCI pat c = some [] ↔ c ∈ ciMatches pat := by
  induction pat generalizing c with
  | nil =>
      simp [matchLitCI, ciMatches]
  | cons p ps ih =>
      cases c with
      | nil =>
          simp [matchLitCI, ciMatches]
      | cons x xs =>
          simp only [matchLitCI]
          rw [cert_if_some_nil]
          rw [ih]
          rw [cert_mem_ciMatches_cons]
          rw [cert_byteCiEq]

/-- The six (lower, upper) letter pairs of the closer spelling, in pattern order. -/
def certLetterPairs : List (Nat × Nat) :=
  [(109, 77), (111, 79), (100, 68), (117, 85), (108, 76), (101, 69)]

/-- The case product of the letter pairs, lower branch first, first pair slowest. -/
def certSpellingLetters : List (Nat × Nat) → List (List Nat)
  | [] => [[]]
  | (lo, up) :: rest =>
      (certSpellingLetters rest).map (fun t => lo :: t) ++
        (certSpellingLetters rest).map (fun t => up :: t)

/-- The 64 closer spellings with the fixed brackets and slash. -/
def certSpellings : List (List Nat) :=
  (certSpellingLetters certLetterPairs).map
    (fun letters => [91, 91, 47] ++ letters ++ [93, 93])

/-- The inverse generator at the concrete closer equals the explicit case product: kernel check of the full 64-element enumeration. -/
theorem cert_ciMatches_eq_spellings : ciMatches certCloserBytes = certSpellings := by
  decide

/-- Universal closer converse: for EVERY byte list c, an exact case-insensitive match consuming the whole subject iff c is one of the 64 generated spellings. This closes the inherited report's named converse remainder on the byte-list domain. -/
theorem cert_universal (c : List Nat) :
    matchLitCI certCloser c = some [] ↔ c ∈ certSpellings := by
  rw [certCloser_eq_bytes]
  rw [cert_mem_ciMatches]
  rw [cert_ciMatches_eq_spellings]

/-- Byte-list replacement at an index, for the near-miss quotient. -/
def certReplaceAt : Nat → Nat → List Nat → List Nat
  | _, _, [] => []
  | 0, b, _ :: xs => b :: xs
  | i + 1, b, x :: xs => x :: certReplaceAt i b xs

/-- An injective byte bump: replacing a letter byte with bump b preserves the distinction between the lower and upper spelling that differed only at that byte, so the generated domain stays duplicate-free. -/
def certBumpByte (b : Nat) : Nat := if b < 255 then b + 1 else 0

/-- Near-miss quotient: ten alteration classes per spelling — three wrong brackets, two injective wrong-letter bumps, two truncations, and three length extensions including a doubled spelling and two 0xFF-adjacent lists. -/
def certNearMisses : List (List Nat) :=
  certSpellings.flatMap fun c =>
    [ certReplaceAt 0 93 c,
      certReplaceAt 2 92 c,
      certReplaceAt 10 91 c,
      certReplaceAt 3 (certBumpByte (c.getD 3 0)) c,
      certReplaceAt 4 (certBumpByte (c.getD 4 0)) c,
      c.drop 1,
      c.take 10,
      c ++ [255],
      [255] ++ c,
      c ++ c ]

/-- The explicit finite domain: exact spellings first, then near misses. -/
def certDomain : List (List Nat) := certSpellings ++ certNearMisses

theorem certSpellings_length : certSpellings.length = 64 := by
  decide

theorem certSpellings_len11 : certSpellings.all (fun c => c.length == 11) = true := by
  decide

def certAccepts (c : List Nat) : Bool := matchLitCI certCloser c == some []

theorem certSpellings_all_match : certSpellings.all certAccepts = true := by
  decide

theorem certNearMisses_length : certNearMisses.length = 640 := by
  decide

theorem certDomain_length : certDomain.length = 704 := by
  decide

theorem certDomain_nodup : certDomain.Nodup := by
  decide

def certIsSpelling (c : List Nat) : Bool := decide (c ∈ certSpellings)

/-- Zero-mismatch exhaustive check: over the entire generated domain, acceptance and membership agree. Kernel decide, no oracle, no sampling. -/
theorem cert_bounded_zero_mismatch :
    certDomain.all (fun c => certAccepts c == certIsSpelling c) = true := by
  decide

/-- The bounded converse, stated on its own so the certificate is auditable without the universal lemma: for any generated candidate, acceptance iff spelling membership. -/
theorem cert_bounded_converse (c : List Nat) (hc : c ∈ certDomain) :
    matchLitCI certCloser c = some [] ↔ c ∈ certSpellings := by
  have hflag : (certAccepts c == certIsSpelling c) = true :=
    List.all_eq_true.mp cert_bounded_zero_mismatch c hc
  have hbeq : certAccepts c = certIsSpelling c := (beq_iff_eq).mp hflag
  have hbeq' : (matchLitCI certCloser c == some []) = decide (c ∈ certSpellings) := by
    simpa [certAccepts, certIsSpelling] using hbeq
  constructor
  · intro h
    have hleft : (matchLitCI certCloser c == some []) = true := (beq_iff_eq).mpr h
    have hright : decide (c ∈ certSpellings) = true := by
      rwa [← hbeq']
    by_cases hn : c ∈ certSpellings
    · exact hn
    · have hf : decide (c ∈ certSpellings) = false := by simp [hn]
      rw [hf] at hright
      contradiction
  · intro h
    have hright : decide (c ∈ certSpellings) = true := by simp [h]
    have hleft : (matchLitCI certCloser c == some []) = true := by
      rwa [hbeq']
    exact (beq_iff_eq).mp hleft

/-- Every accepted byte list has length exactly eleven, so non-11-byte lists (including 0xFF-bearing ones) are outside the antecedent, not uncovered counterexamples. -/
theorem cert_accepted_len11 {c : List Nat} (h : matchLitCI certCloser c = some []) : c.length = 11 := by
  have hm : c ∈ certSpellings := (cert_universal c).mp h
  have hb : (c.length == 11) = true := List.all_eq_true.mp certSpellings_len11 c hm
  exact (beq_iff_eq).mp hb

/-- No near miss in the generated quotient is accepted: an explicit exhaustive pin over all 640 altered candidates. -/
theorem cert_near_misses_rejected : certNearMisses.all (fun c => certAccepts c == false) = true := by
  decide

/-- Deterministic reproducibility hash of the generated domain, in generation order. -/
def certHashStep (h : Nat) (c : List Nat) : Nat :=
  c.foldl (fun acc b => (acc * 257 + b) % 1000000007)
    ((h * 257 + c.length) % 1000000007)

def certHash : Nat := certDomain.foldl certHashStep 0

#eval certSpellings.length
#eval certNearMisses.length
#eval certDomain.length
#eval decide certDomain.Nodup
#eval certHash
#eval certDomain.all (fun c => certAccepts c == certIsSpelling c)
#eval certSpellings.all certAccepts
#eval certNearMisses.all (fun c => certAccepts c == false)

#print axioms ciMatches_cons_eq
#print axioms certCloser_eq_bytes
#print axioms cert_byteCiEq
#print axioms cert_if_some_nil
#print axioms cert_mem_ciMatches_cons
#print axioms cert_mem_ciMatches
#print axioms cert_ciMatches_eq_spellings
#print axioms cert_universal
#print axioms certReplaceAt
#print axioms certSpellings_length
#print axioms certSpellings_len11
#print axioms certSpellings_all_match
#print axioms certNearMisses_length
#print axioms certDomain_length
#print axioms certDomain_nodup
#print axioms cert_bounded_zero_mismatch
#print axioms cert_bounded_converse
#print axioms cert_accepted_len11
#print axioms cert_near_misses_rejected

end LeanFtml
